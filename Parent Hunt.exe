String name = "";
String twin = "";
int safety = 3;
int morale = 3;
int energy = 4;
boolean hasMap = false;    // item
boolean gameOver = false;  // true when any stat hits 0
String message = "";

String choice = "";           // moved up here so every step can use it
int step = 0;                 // which scene we're in
boolean waiting = true;       // true = waiting for the player to click the window
boolean ended = false;        // true once an ending is shown

void setup() {
  size(600, 400);

  // Intro
  println("Twin siblings, age 7, wake up in their bedroom to missing parents.");
  println("They set out on a quest to find their mother and father.");
  message = "Twin siblings, age 7, wake up in their bedroom to missing parents.\nThey set out on a quest to find their mother and father.\n";
}

void draw() {

  // Lose check (runs every frame)
  if (!gameOver) {
    if (safety <= 0) {
      gameOver = true;
      message = "GAME OVER: You ran out of SAFETY.";
      println(message);
    } else if (morale <= 0) {
      gameOver = true;
      message = "GAME OVER: You ran out of MORALE and gave up.";
      println(message);
    } else if (energy <= 0) {
      gameOver = true;
      message = "GAME OVER: You ran out of ENERGY and fell asleep.";
      println(message);
    }
  }

  // Had to search this up...
  if (!gameOver && !ended && !waiting) {

    // SCENE 0: pick a sibling
    if (step == 0) {
      name = Ask.forString("Pick a sibling: Estelle OR Calus?");
      name = name.toLowerCase();
      if (name.equals("calus")) {
        name = "Calus";
        twin = "Estelle";
      } else {
        name = "Estelle";
        twin = "Calus";
      }
      message = "You picked " + name + "!";
      println(message);
      step = 1;
      waiting = true;
    }

    // Scene 1: Where?
    else if (step == 1) {
      message = "You" + " and " + twin + " look around the house and find no one.\n-1 energy, -1 morale";
      println(message);
      energy = energy - 1;
      morale = morale - 1;
      step = 2;
      waiting = true;
    }

    // Scene 1: wait or leave
    else if (step == 2) {
      choice = Ask.forString("Do you wait OR leave?");
      choice = choice.toLowerCase();
      if (choice.equals("wait")) {

        safety = safety + 1;
        println("No progression for now...");
        choice = Ask.forString("Still nobody. Do you wait more OR leave?");
        println("Waiting won't bring them back. You have to go.");
      }
      safety = safety - 2;
      message = "You better be careful!...";
      println(message);
      step = 3;
      waiting = true;
    }

    // Scene 2: Stranger Danger
    else if (step == 3) {
      message = "Outside, a stranger in a long coat waves at you.";
      println(message);
      step = 4;
      waiting = true;
    }

    // Scene 2: talk or ignore
    else if (step == 4) {
      choice = Ask.forString("Do you TALK to the stranger OR IGNORE them?");
      choice = choice.toLowerCase();

      if (choice.equals("talk")) {
        int roll = int(random(1, 7));   // 1 to 6
        if (roll >= 4) {
          message = "The stranger smiles and is very kind! They give you a MAP. +1 morale";
          hasMap = true;
          morale = morale + 1;
        } else {
          message = "The stranger is rude and says, \"Go away, weird kids!\" That hurt your feelings. -1 morale";
          morale = morale - 1;
        }
      } else {
        message = "You hurry past. It was lonely, though. -1 morale";
        morale = morale - 1;
      }
      println(message);
      energy = energy - 1;
      step = 5;
      waiting = true;
    }

    // Scene 3: Bad Fortune (randomness)
    else if (step == 5) {
      int luck = int(random(1, 7));
      if (luck <= 2) {
        message = "You keep walking down the road...\nYou trip on a rock and scrape your knee! -1 energy";
        energy = energy - 1;
      } else if (luck <= 4) {
        message = "You keep walking down the road...\nIt starts to rain. You're cold and sad. -1 morale";
        morale = morale - 1;
      } else {
        message = "You keep walking down the road...\nYou find half a sandwich in your pocket! +1 energy";
        energy = energy + 1;
      }
      println(message);
      step = 6;
      waiting = true;
    }

    // Scene 4: Take Risks Kids!
    else if (step == 6) {
      message = "The road splits: a dark shortcut through the woods, or the long way around.";
      println(message);
      step = 7;
      waiting = true;
    }

    // Scene 4: shortcut or long way
    else if (step == 7) {
      choice = Ask.forString("Take the SHORTCUT OR the LONG way?");
      choice = choice.toLowerCase();

      if (choice.equals("shortcut")) {
        energy = energy - 1;
        int danger = int(random(1, 7));
        if (danger <= 2) {
          message = "Something growls in the trees! You run! -2 safety";
          safety = safety - 2;
        } else {
          message = "You make it through safely. +1 morale";
          morale = morale + 1;
        }
      } else {
        message = "The long way is tiring. -2 energy";
        energy = energy - 2;
      }
      println(message);
      step = 8;
      waiting = true;
    }

    // Endings (only if you survived)
    else if (step == 8) {
      if (hasMap && morale >= 3) {
        message = "ENDING A: The map leads you straight to Mom and Dad. You did it!";
      } else if (morale >= 2) {
        message = "ENDING B: You find your parents, but it took everything you had.";
      } else {
        message = "ENDING C: You find a house with a light on... but it isn't home.";
      }
      println(message);
      ended = true;
    }
  }

  // Drawing
  background(20, 20, 40);

  // message (turns red for game over cuz dramatic effect)
  if (gameOver) {
    fill(255, 80, 80);
  } else {
    fill(255);
  }
  textSize(16);
  text(message, 30, 40, 500, 250);

  // click hint
  if (waiting && !gameOver && !ended) {
    fill(180);
    textSize(14);
    text("(Click the screen to continue)", 30, 300);
  }

  // stats (numbers only)
  textSize(14);
  fill(255, 100, 100);
  text("Safety: " + max(safety, 0), 30, 330);

  fill(100, 180, 255);
  text("Morale: " + max(morale, 0), 30, 355);

  fill(255, 220, 80);
  text("Energy: " + max(energy, 0), 30, 380);

  if (hasMap) {
    fill(200, 160, 100);
    rect(540, 20, 30, 20);
    fill(0);
    text("MAP", 543, 35);
  }
}

// click the window to continue
void mousePressed() {
  waiting = false;
}